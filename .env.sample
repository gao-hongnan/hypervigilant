ENV=development
DEBUG=true

S3__ENDPOINT_URL=http://host.docker.internal:9000
S3__AWS_ACCESS_KEY_ID=minioadmin
S3__AWS_SECRET_ACCESS_KEY=minioadmin

OPENAI__API_KEY=
OPENAI__MODEL_NAME=gpt-4o-mini
OPENAI__TEMPERATURE=0.0
OPENAI__MAX_COMPLETION_TOKENS=1000
OPENAI__LOGPROBS=false

# hypervigilant reads no environment variables of its own. `DBConfig` is a plain
# pydantic model; the consuming application nests it in its own BaseSettings and
# therefore picks its own prefix. Names below are illustrative -- swap MYAPP_ for
# whatever `env_prefix` your settings class declares.
#
#   class AppSettings(BaseSettings):
#       model_config = SettingsConfigDict(env_prefix="MYAPP_", env_nested_delimiter="__")
#       db: DBConfig
#
# MYAPP_DB__HOST=localhost
# MYAPP_DB__PORT=5432
# MYAPP_DB__USER=app
# MYAPP_DB__DATABASE=app
# MYAPP_DB__SSL__MODE=prefer
#
# Optional read replica. On Aurora this is the cluster's reader endpoint;
# credentials, port and database are inherited from the writer above.
# MYAPP_DB__READER__HOST=mydb.cluster-ro-xyz.us-east-1.rds.amazonaws.com
# MYAPP_DB__READER__POOL_SIZE=3
